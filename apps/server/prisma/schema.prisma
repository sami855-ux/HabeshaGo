
generator client {
  provider = "prisma-client-js"
}

// generator dbml {
//   provider = "prisma-dbml-generator"
//   output   = "./ERD.dbml"
// }
// generator erd {
//   provider = "prisma-erd-generator"
//   output   = "./ERD.svg"
// }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  password      String? // optional for social/otp flows
  phone         String?  @unique
  role          UserRole @default(PASSENGER)
  provider      String?
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts      Account[]
  otpCodes      OtpCode[]
  refreshTokens RefreshToken[]
  wallet        Wallet?

  bookings   Booking[]
  parkings   ParkingReservation[]
  minibuses  MinibusReservation[]
  chargings  ChargingSession[]
  driverInfo Driver? // if this user is a driver
  image      String?
  sessions   Session[]

  @@map("user")
}

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
}

model Wallet {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  balance   Float    @default(0)
  currency  String   @default("ETB")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String   @id @default(cuid())
  provider              String
  providerId            String
  user                  User      @relation(fields: [userId], references: [id])
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accountId String
  password  String?

  @@unique([provider, providerId])
  @@index([userId])
  @@map("account")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  email     String? // either email or phone will be filled
  phone     String?
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
}


//Bus features 
model Bus {
  id              Int         @id @default(autoincrement())
  busNumber       String      @unique
  capacity        Int
  status          BusStatus   @default(ACTIVE)
  driver          Driver?     @relation(fields: [driverId], references: [id])
  driverId        Int?        @unique
  route           Route?      @relation(fields: [routeId], references: [id])
  routeId         Int?

  currentStop     String?
  nextDestination String?
  isActive        Boolean     @default(true)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  bookings        Booking[]
  positions       BusPosition[]  
}

model Booking {
  id             Int        @id @default(autoincrement())
  user           User       @relation(fields: [userId], references: [id])
  userId         String
  bus            Bus        @relation(fields: [busId], references: [id])
  busId          Int
  seatNumber     Int
  date           DateTime
  status         BookingStatus  @default(CONFIRMED)
  boardingStop   String?        //  multi-stop routes
  alightingStop  String?        //  multi-stop routes
  bookingCode    String     @unique @default(uuid())
  cancelledAt    DateTime?      //  timestamp if cancelled
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model BusPosition {
  id        Int      @id @default(autoincrement())
  bus       Bus      @relation(fields: [busId], references: [id])
  busId     Int
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())

  @@index([busId, timestamp])
}


model Route {
  id          Int       @id @default(autoincrement())
  name        String
  origin      String
  destination String
  distanceKm  Float?
  estimatedTimeMin Int?          // estimated travel time in minutes
  midPoints   Json?              // array of intermediate stops: [{ name: "Stop1", lat: xx, lng: yy }, ...]
  isActive    Boolean   @default(true)  // whether this route is currently active
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  minibuses   Minibus[]
  buses       Bus[]
}





model EVStation {
  id        Int      @id @default(autoincrement())
  name      String
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots ChargingSlot[]
}

model ChargingSlot {
  id         Int        @id @default(autoincrement())
  slotNumber String
  status     SlotStatus @default(AVAILABLE)
  station    EVStation  @relation(fields: [stationId], references: [id])
  stationId  Int

  sessions ChargingSession[]
}

enum SlotStatus {
  AVAILABLE
  OCCUPIED
  OUT_OF_SERVICE
}

model ChargingSession {
  id         Int          @id @default(autoincrement())
  user       User         @relation(fields: [userId], references: [id])
  userId     String
  slot       ChargingSlot @relation(fields: [slotId], references: [id])
  slotId     Int
  startTime  DateTime
  endTime    DateTime?
  energyUsed Float?
  cost       Float?
  createdAt  DateTime     @default(now())
}


model Driver {
  id              Int      @id @default(autoincrement())
  user            User     @relation(fields: [userId], references: [id])
  userId          String   @unique
  licenseNo       String
  experience      Int?
  assignedBus     Bus?
  assignedMinibus Minibus?
}

model Minibus {
  id          Int      @id @default(autoincrement())
  plateNumber String   @unique
  capacity    Int
  driver      Driver?  @relation(fields: [driverId], references: [id])
  driverId    Int?     @unique
  route       Route?   @relation(fields: [routeId], references: [id])
  routeId     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations MinibusReservation[]
}

model MinibusReservation {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  minibus   Minibus  @relation(fields: [minibusId], references: [id])
  minibusId Int
  seat      Int
  date      DateTime
  createdAt DateTime @default(now())
}



model ParkingLot {
  id         Int      @id @default(autoincrement())
  name       String
  location   String
  totalSlots Int
  occupied   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reservations ParkingReservation[]
}

model ParkingReservation {
  id         Int        @id @default(autoincrement())
  user       User       @relation(fields: [userId], references: [id])
  userId     String
  lot        ParkingLot @relation(fields: [lotId], references: [id])
  lotId      Int
  slotNumber Int
  startTime  DateTime
  endTime    DateTime
  createdAt  DateTime   @default(now())
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}


enum BusStatus {
  ACTIVE
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
}