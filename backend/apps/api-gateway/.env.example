NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# CORS & Client URLs
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379

# Authentication & Trust Boundary Secrets
JWT_ACCESS_SECRET=your-access-token-secret-min-16-chars
INTERNAL_JWT_SECRET=your-internal-service-secret-min-16-chars
INTERNAL_TOKEN_TTL_SECONDS=60

# Request Limits
MAX_BODY_BYTES=1048576
RATE_LIMIT_IP_PER_MINUTE=300
RATE_LIMIT_USER_PER_MINUTE=120

# Upstream Microservice Endpoints
AUTH_SERVICE_URL=http://localhost:4001
PROFILE_SERVICE_URL=http://localhost:4002
MOBILITY_SERVICE_URL=http://localhost:4003
TICKET_SERVICE_URL=http://localhost:4004
PAYMENT_SERVICE_URL=http://localhost:4005
PARKING_SERVICE_URL=http://localhost:4006
EV_SERVICE_URL=http://localhost:4007
EMPLOYEE_SERVICE_URL=http://localhost:4008
NOTIFICATION_SERVICE_URL=http://localhost:4009
REPORTING_SERVICE_URL=http://localhost:4010
