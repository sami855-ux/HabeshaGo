# ==============================================================================
# HabeshaGo Authentication Service (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Database Connections (PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection for high-concurrency application runtime (URL-encode special characters in password)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/habeshago_auth?schema=public

# Direct unpooled connection for Prisma migrations and schema DDL
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/habeshago_auth?schema=public

# ------------------------------------------------------------------------------
# 3. JWT & Session Security
# ------------------------------------------------------------------------------
# Secret used for user access tokens (must match API Gateway JWT_ACCESS_SECRET, min 16 chars)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_16_chars_here

# Secret used for signing and verifying refresh tokens (min 16 chars)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_16_chars_here

# Token Lifetimes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ------------------------------------------------------------------------------
# 4. Internal Trust Boundary (API Gateway -> Auth Service)
# ------------------------------------------------------------------------------
# Shared secret for validating x-internal-token issued by api-gateway (min 16 chars)
INTERNAL_JWT_SECRET=your_internal_gateway_jwt_secret_min_16_chars_here
INTERNAL_TOKEN_TTL_SECONDS=60

# ------------------------------------------------------------------------------
# 5. Multi-Factor Authentication (MFA)
# ------------------------------------------------------------------------------
# 32-byte key (64 hex characters or 32-byte base64) for AES-256-GCM encryption of TOTP secrets
# Generate via: openssl rand -hex 32
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 6. One-Time Password (OTP) Configuration
# ------------------------------------------------------------------------------
# Lifetime of email verification / login OTP in minutes (default: 10)
OTP_TTL_MINUTES=10

# Maximum failed verification attempts before OTP is invalidated (default: 5)
OTP_MAX_ATTEMPTS=5

# Cooldown period in seconds before requesting/resending a new OTP (default: 60)
OTP_RATE_LIMIT_SECONDS=60

# ------------------------------------------------------------------------------
# 7. Google OAuth 2.0
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4001/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 8. Web Client & Frontend URLs
# ------------------------------------------------------------------------------
# Frontend client URL used for OAuth redirects and staff invite acceptance links
FRONTEND_URL=http://localhost:3000
