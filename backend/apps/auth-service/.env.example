NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/habeshago_auth?schema=public

# Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_16_chars_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_16_chars_here
INTERNAL_JWT_SECRET=your_internal_gateway_jwt_secret_min_16_chars_here

# Token Lifetimes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
